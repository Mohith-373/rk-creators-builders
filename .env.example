[build]
  command = "echo 'Static site - no build step required'"
  publish = "."

# Netlify Functions (backend API)
[functions]
  directory = "netlify/functions"

# Local development only - never commit real secrets.
# Copy this file to .env and fill in real values.
# In production, set these as Netlify environment variables (Site settings > Environment variables).
ADMIN_TOKEN=change-me-to-a-long-random-secret
SITE_URL=https://rk-creators-builders.netlify.app

# Optional email notifications via SMTP. If left unset, enquiries are stored
# in the admin dashboard and listed there instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="RK Creators & Builders <no-reply@example.com>"
OWNER_EMAIL=
